{
    "name": "Raft dev container",
    "image": "golang:1.23",
    "mounts": [
        "source=${localWorkspaceFolder},target=/src,type=bind",
        "source=/etc/localtime,target=/etc/localtime,type=bind,ro",
        "source=/etc/timezone,target=/etc/timezone,type=bind,ro"
    ],
    "customizations" : {
        "jetbrains" : {
            "backend" : "GoLand",
            "settings" : {
            },
            "plugins": [
            ]
        },
        "vscode": {
            "extensions": [
                "microsoft.docker",
                "golang.go"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/git" : {},
        "ghcr.io/devcontainers/features/docker-in-docker": {}
    },
}